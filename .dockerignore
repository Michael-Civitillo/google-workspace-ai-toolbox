# Build inputs only. Anything else would either bloat the context or - worse -
# bake local state and secrets into the image.
node_modules
.next
packaging/dist
.git
.github
docs
# Only the image's health check is needed from deploy/.
deploy/*
!deploy/docker
*.md

# Local state: never ship a tenants file, sign-on config, audit log or keys.
.env
.env.*
!.env.example
tenants.json*
sso.json*
app-config.json*
delegation-sightings.json*
security-check-history.json*
audit.log
session-secret
credentials
