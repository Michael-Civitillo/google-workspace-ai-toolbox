# Copy to .env and fill in. Keep .env out of version control (it is gitignored).

# The hostname you route through the tunnel, without https://
PUBLIC_HOSTNAME=admin.example.com

# Password for the web interface (12+ characters). Cloudflare Access is the
# first lock on the door; this is the second.
APP_PASSWORD=

# Signs session cookies. Generate once:  openssl rand -hex 32
APP_SESSION_SECRET=

# From Zero Trust -> Networks -> Tunnels -> your tunnel -> "Install and run a
# connector": the long token after `--token`.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional. Tenants can carry their own Gemini key in the UI instead.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=
