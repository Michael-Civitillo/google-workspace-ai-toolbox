{
  "name": "google-workspace-open-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prune-standalone.mjs",
    "start": "next start",
    "lint": "eslint",
    "screenshots": "node scripts/screenshots.mjs",
    "test:launcher": "node --test \"packaging/launcher/test/*.test.ts\"",
    "package": "npm run build && npm run package:payload && npm run package:launcher",
    "package:payload": "node packaging/build-payload.mjs",
    "package:launcher": "node packaging/build-launcher.mjs",
    "package:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File packaging/build-exe.ps1",
    "package:bin": "bash packaging/build-bin.sh",
    "package:smoke": "node packaging/smoke.mjs",
    "package:icon": "node packaging/make-icon.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.53",
    "@base-ui/react": "^1.3.0",
    "ai": "^6.0.141",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^10.6.2",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "openid-client": "^6.8.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "fflate": "^0.8.2",
    "postject": "^1.0.0-alpha.6",
    "puppeteer": "^24.40.0",
    "resedit": "^2.0.3",
    "shadcn": "^4.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
