# --- Required ---

# Password for the Open Admin UI. The app refuses to start mutating actions if
# this is unset, so it can never be deployed wide-open by accident.
APP_PASSWORD=change-me-to-something-long-and-random

# Optional but recommended: a separate high-entropy secret used to sign
# session cookies. Setting this decouples the session signature from
# APP_PASSWORD, so a stolen cookie can't be used to brute-force the password
# offline. Generate with e.g. `openssl rand -hex 32`. Falls back to
# APP_PASSWORD when unset.
# APP_SESSION_SECRET=

# Optional: where this install keeps its state — tenants.json,
# app-config.json, sso.json, audit.log and any service-account keys restored
# from a configuration backup. Defaults to the working directory, which is
# what you want when running from source. The packaged Windows build sets it
# to a folder in your user profile, because its application directory is
# replaced on every upgrade.
# OPEN_ADMIN_DATA_DIR=/var/lib/gws-open-admin

# --- Behind a reverse proxy: Cloudflare Tunnel, nginx, Docker (optional) ---

# The public origin(s) browsers use to reach the app, comma-separated. Behind a
# proxy the browser's Origin header is the public URL while the server only
# knows the address it bound, so without this every mutating request is
# refused as cross-origin (403). Not needed when browsing http://localhost.
# See docs/DEPLOY-CLOUDFLARE.md.
# APP_ALLOWED_ORIGINS=https://admin.example.com

# Set to true only when nothing but a trusted proxy can reach the app. The
# login rate limiter then reads X-Forwarded-For for the client address instead
# of throttling everyone as one.
# TRUSTED_PROXY=true

# --- Single sign-on (optional) ---

# Single sign-on is configured from the UI (Single Sign-On page → setup wizard)
# and stored in sso.json next to tenants.json. Override the location here.
# SSO_CONFIG_PATH=/etc/gws-open-admin/sso.json

# Break-glass: switch single sign-on off (and bring the password form back)
# without touching sso.json — e.g. when the identity provider is down.
# APP_SSO_DISABLED=true

# Allow an issuer on a private, loopback or link-local host (a development
# provider, or a Keycloak on the LAN). Refused by default: the server is what
# fetches the issuer, so an unrestricted check would report which ports answer
# on its own network.
# APP_SSO_ALLOW_PRIVATE_ISSUER=true

# Accept a sign-in whose ID token carries no `email_verified: true` claim.
# Refused by default: a session here is full tenant admin, and against a
# provider where users set their own email an unverified address means someone
# can present an allowlisted address they do not own. Entra ID is exempt
# already (its UPN is administrator-controlled).
# APP_SSO_TRUST_UNVERIFIED_EMAIL=true

# --- Workspace credentials (used as fallback if no tenant is selected) ---

# Google Workspace CLI — absolute path to your service account JSON key.
# Examples: /Users/me/keys/sa.json (macOS/Linux) or C:\creds\sa.json (Windows)
GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=/path/to/service-account.json

# Optional: override the gws binary resolution. Defaults to "gws" (or
# "gws.cmd" on Windows). Set this if you installed gws via a non-PATH
# location or as gws.exe.
# GWS_BIN=C:\path\to\gws.exe

# Admin email for impersonation (needed for Domain Change feature)
GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@yourdomain.com

# --- AI ---

# Gemini API key for AI features (get one at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Optional: Gemini model id used by the AI features. Defaults to
# gemini-2.0-flash; set this to adopt a newer model without a code change.
# GEMINI_MODEL=gemini-2.5-flash
